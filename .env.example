# Copy to .env (never commit .env) or set these in your host's dashboard.

# Required in production. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
OMNIARMOR_ENV=production

# Public address of the app, used in emails and links. OmniArmor is a product of
# MTRX Horizyn and runs on a subdomain of its domain (docs/OPERATIONS.md, section 1).
BASE_URL=https://omniarmor.example.com
# Only for docker-compose.yml: the name Caddy gets a free HTTPS certificate for.
DOMAIN=omniarmor.example.com

# Where the database and backups live. Use a persistent disk.
DATABASE_PATH=/data/omniarmor.db
BACKUP_DIR=/data/backups
BACKUP_KEEP=14

# Email for reminders and password resets (any SMTP provider: Postmark, SendGrid, Amazon SES, Mailgun...).
# Leave SMTP_HOST empty and emails are saved in the app's Reminders page instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
# An address of OmniArmor's own on MTRX Horizyn's domain. SPF, DKIM and DMARC are
# set up once on that domain (docs/OPERATIONS.md, section 2).
MAIL_FROM=OmniArmor <no-reply@omniarmor.example.com>

# Hour (UTC, 0-23) after which the daily reminders and backup run.
DAILY_JOB_HOUR_UTC=11
SCHEDULER_ENABLED=1

# Autopilot checks the service every 10 minutes. It fixes small problems itself
# (re-sends failed emails, makes a missed backup, tidies logs) and emails big ones
# to OPERATOR_EMAIL: failing backups or email, error spikes, low disk, a damaged database.
AUTOPILOT_ENABLED=1
OPERATOR_EMAIL=you@example.com

# Server size. One process with 8 threads handles a lot of traffic on a tiny VM.
WEB_CONCURRENCY=1
WEB_THREADS=8

# The Academy's own subscription (optional). Without Stripe keys, turn it on by hand:
#   flask --app wsgi academy-plan <workspace id> active
ACADEMY_TRIAL_DAYS=14
ACADEMY_PRICE_LABEL=
ACADEMY_STRIPE_PRICE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
