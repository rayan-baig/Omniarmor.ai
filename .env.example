# Copy to .env (never commit .env) or set these in your host's dashboard.

# Required in production. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
OMNIARMOR_ENV=production

# Public address of the app, used in emails and links. OmniArmor is a product of
# MTRX Horizyn and runs on a subdomain of its domain (docs/OPERATIONS.md, section 1).
BASE_URL=https://omniarmor.mtrxhorizyn.com
# Only for docker-compose.yml: the name Caddy gets a free HTTPS certificate for.
DOMAIN=omniarmor.mtrxhorizyn.com

# Where the database and backups live. Use a persistent disk.
DATABASE_PATH=/data/omniarmor.db
BACKUP_DIR=/data/backups
BACKUP_KEEP=14

# Email for reminders and password resets (any SMTP provider: Postmark, SendGrid, Amazon SES, Mailgun...).
# Leave SMTP_HOST empty and emails are saved in the app's Reminders page instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
# An address of OmniArmor's own on MTRX Horizyn's domain. SPF, DKIM and DMARC are
# set up once on that domain (docs/OPERATIONS.md, section 2).
MAIL_FROM=OmniArmor <no-reply@omniarmor.mtrxhorizyn.com>

# Hour (UTC, 0-23) after which the daily reminders and backup run.
DAILY_JOB_HOUR_UTC=11
SCHEDULER_ENABLED=1

# Autopilot checks the service every 10 minutes. It fixes small problems itself
# (re-sends failed emails, makes a missed backup, tidies logs) and emails big ones
# to OPERATOR_EMAIL: failing backups or email, error spikes, low disk, a damaged database.
AUTOPILOT_ENABLED=1
OPERATOR_EMAIL=you@example.com

# Optional: one inbox that gets a short report of each server error (a 500) right away:
# time, version, method and path (no query string), error and stack trace. No personal data.
# One email per distinct error an hour, at most 20 a day. Leave empty to send none.
ERRORS_EMAIL=

# Optional: an address people can write to for help, shown on the Help page (/help).
# Live: help@omniarmor.mtrxhorizyn.com, once that mailbox exists.
SUPPORT_EMAIL=

# Only on a copy that is not the live one (staging, a demo service): 1 keeps the
# whole site out of search results (docs/STAGING.md). Leave it unset on live.
NOINDEX=

# Server size. One process with 8 threads handles a lot of traffic on a tiny VM.
WEB_CONCURRENCY=1
WEB_THREADS=8

# Plans: a free trial, then Pro or Plus, per location, paid monthly or yearly (a
# year costs 10 months). The prices live in the code (omniarmor_app/plans.py);
# these are only Stripe's ids for them. Without Stripe keys, put a workspace on a
# plan by hand:
#   flask --app wsgi plan <workspace id> pro|plus|classroom|school [--yearly] [--until YYYY-MM-DD]
# The free trial's length, in days, for the whole app (the name is from when only
# the Academy had a trial).
ACADEMY_TRIAL_DAYS=14
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price ids, each a per-location monthly price: Pro, Plus, and Plus for a
# Kitchen Safety Bundle workspace (the difference between Plus and Pro).
PRO_STRIPE_PRICE=
PLUS_STRIPE_PRICE=
PLUS_BUNDLE_UPGRADE_STRIPE_PRICE=
# The same three as per-location yearly prices ($500, $800 and $300 a year: ten
# months' price). Leave one empty and that plan is offered monthly only.
PRO_YEARLY_STRIPE_PRICE=
PLUS_YEARLY_STRIPE_PRICE=
PLUS_BUNDLE_UPGRADE_YEARLY_STRIPE_PRICE=
# Classroom plans for schools (yearly only): Classroom ($299 a year, one class of
# up to 35 students, the Academy) and Whole school ($1,490 a year, every class and
# the school's checklist). The prices live in omniarmor_app/plans.py; these are
# their yearly Stripe price ids. Leave one empty and that plan is sold by invoice
# only: set it by hand with `flask --app wsgi plan <id> classroom --until <date>`.
CLASSROOM_YEARLY_STRIPE_PRICE=
SCHOOL_YEARLY_STRIPE_PRICE=
# The free classroom pilot's length in days (once per workspace, no card needed).
CLASSROOM_PILOT_DAYS=30
# Where a school writes to pay by invoice, shown on the classes page and the
# Academy for schools page. Unset: SUPPORT_EMAIL, and without that help@mtrxhorizyn.com.
SCHOOL_INVOICE_EMAIL=
# The one-time save offer on the cancel screen: a Stripe coupon id, and the
# amount the screen promises, which must match that coupon (by default 25% off
# the next 2 months: a coupon with percent_off 25, duration "repeating",
# duration_in_months 2). Each workspace can take it once, ever. Leave the coupon
# empty and there is no save offer; pausing and cancelling still work.
SAVE_OFFER_STRIPE_COUPON=
SAVE_OFFER_PERCENT=25
SAVE_OFFER_MONTHS=2

# The Kitchen Safety Bundle: the secret CyberLogix signs its daily reports with,
# the same value set on CyberLogix. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Unset, reports still fill in the checks but none counts toward the bundle's Pro.
KITCHEN_BUNDLE_SECRET=
